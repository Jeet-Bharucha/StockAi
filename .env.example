# ── Required ──────────────────────────────────────────────────────────────────
# Finnhub API key — free at https://finnhub.io/dashboard
FINNHUB_KEY=your_finnhub_api_key

# MongoDB Atlas connection string — free at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/stockai?retryWrites=true&w=majority

# JWT secret — any long random string (openssl rand -hex 32)
JWT_SECRET=your_long_random_secret_here

# ── AI Analysis (optional) ────────────────────────────────────────────────────
# Anthropic Claude API — https://console.anthropic.com
# Enables AI-powered natural language analysis in the dashboard
ANTHROPIC_API_KEY=your_anthropic_api_key

# ── Automated Email/SMS Alerts (optional) ─────────────────────────────────────
# Resend API key — free at https://resend.com (100 emails/day, works on Render free tier)
RESEND_API_KEY=re_your_api_key_here
# Where to receive alerts (comma-separated for email + SMS gateway)
ALERT_EMAIL_TO=your@email.com

# ── Private Mode (optional) ───────────────────────────────────────────────────
# Adds HTTP Basic Auth popup before any page loads
SITE_PASSWORD=your_site_password
# Restricts registration and login to one email address
ALLOWED_EMAIL=your@email.com
# Temporary owner-only registration key (at least 24 random bytes); remove after setup
OWNER_SETUP_KEY=replace_with_random_secret_at_least_24_bytes

# Public service ONLY: leave unset/false until a separate backend, verified sender, and tests are ready.
# Do not enable on stockai-main private owner deployment.
# Explicit site switch for your existing stockai-main.onrender.com.
# False preserves owner-only login, even if signups are configured.
PUBLIC_SITE_ENABLED=false
# Existing owner email, NOT their password; reserve this account when public.
# OWNER_EMAIL=existing-owner@example.com
PUBLIC_SIGNUPS_ENABLED=false

# Password recovery and public registration require a verified sending domain
# and the exact HTTPS origin serving your pages.
SITE_URL=https://stockai-main.onrender.com
RESEND_FROM_EMAIL=verified-sender@your-domain.com

# Optional account research worker (deploy separately from the free web service).
# Set the same flag on the web service after the worker is running so the UI
# reports configuration accurately. Keep existing owner/public flags unchanged.
BACKGROUND_ALERTS_ENABLED=false
# Worker email uses the existing RESEND_API_KEY and RESEND_FROM_EMAIL settings.

# Administrative backup jobs only; use a secrets manager.
# BACKUP_PASSPHRASE=<unique secret of at least 20 characters>
# BACKUP_FILE=<private path>/stockai-YYYY-MM-DD.stockai-backup
# RESTORE_MONGO_URI=<separate empty database ending _restore_test>
# RESTORE_CONFIRM_DATABASE=<exact disposable database name>
